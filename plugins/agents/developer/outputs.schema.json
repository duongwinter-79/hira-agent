{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Developer hand-off result",
  "type": "object",
  "required": ["summary", "changed_files"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Maintainer delta proposal",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "title", "body", "tags"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["adr", "outcome", "convention", "glossary"]
          },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rationale": { "type": "string" }
  }
}

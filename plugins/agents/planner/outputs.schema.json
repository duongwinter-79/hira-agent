{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planner task graph",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "owner", "depends_on"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "owner": {
            "type": "string",
            "enum": [
              "knowledge",
              "solution-architect",
              "developer",
              "tester",
              "reviewer"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rationale": { "type": "string" }
  }
}

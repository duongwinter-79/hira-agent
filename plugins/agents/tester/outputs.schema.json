{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tester output",
  "type": "object",
  "required": ["added_tests", "test_command", "result"],
  "properties": {
    "added_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "framework": { "type": "string" },
          "describes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "test_command": { "type": "string" },
    "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
    "details": { "type": "string" },
    "concerns": { "type": "array", "items": { "type": "string" } }
  }
}
